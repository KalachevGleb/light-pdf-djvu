#pragma code_page(65001)
#include <windows.h>
#include "resource.h"

IDI_APP ICON "../res/lightview.ico"

IDD_PASSWORD DIALOGEX 0, 0, 250, 78
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Пароль"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_PROMPT, 10, 9, 230, 20
    EDITTEXT        IDC_PASSWORD, 10, 32, 230, 14, ES_PASSWORD | ES_AUTOHSCROLL
    DEFPUSHBUTTON   "OK", IDOK, 136, 56, 50, 14
    PUSHBUTTON      "Отмена", IDCANCEL, 190, 56, 50, 14
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041904b0"
        BEGIN
            VALUE "FileDescription", "LightView — просмотр PDF и DjVu"
            VALUE "FileVersion", "0.1.0"
            VALUE "InternalName", "lightview"
            VALUE "LegalCopyright", "© 2026 Kalachev Gleb. GNU GPL v3.0 or later."
            VALUE "OriginalFilename", "lightview.exe"
            VALUE "ProductName", "LightView"
            VALUE "ProductVersion", "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x419, 1200
    END
END
